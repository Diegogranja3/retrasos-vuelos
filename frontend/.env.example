# Copia este archivo como frontend/.env (no se versiona). Sin estas dos variables el mapa no se muestra.
# Token público de Mapbox (empieza con pk.). Restríngelo por URL en tu cuenta de Mapbox.
VITE_MAPBOX_TOKEN=
# Estilo: la URL que da Mapbox Studio, p. ej. mapbox://styles/usuario/id-del-estilo
VITE_MAPBOX_STYLE=
